# ===== 演示模式 =====
# true 时无需数据库即可预览整站（前台 + 后台示例数据）
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# ===== 数据库 =====
DATABASE_URL="postgresql://user:password@localhost:5432/petcraft?schema=public"

# ===== 站点 =====
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Paw & Craft"

# ===== NextAuth =====
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="请用 openssl rand -base64 32 生成"

# ===== 管理员初始账号（用于 seed）=====
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# ===== 支付网关（后台也可配置，这里作为默认/兜底）=====
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

PAYPAL_CLIENT_ID="xxx"
PAYPAL_CLIENT_SECRET="xxx"
PAYPAL_ENV="sandbox"

OCEANPAYMENT_ACCOUNT="xxx"
OCEANPAYMENT_TERMINAL="xxx"
OCEANPAYMENT_SECURE_CODE="xxx"
OCEANPAYMENT_GATEWAY_URL="https://secure.oceanpayment.com/gateway/service/pay"

WINTOPAY_MERCHANT_ID="xxx"
WINTOPAY_SECRET_KEY="xxx"
WINTOPAY_GATEWAY_URL="https://pay.wintopay.com/gateway/pay"
